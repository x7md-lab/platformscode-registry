      "description": "Mimic of DGA DgaDigitalSignature: collapsible verification bar with staggered circular check items.",
      "dependencies": [
        "framer-motion",
        "@hugeicons/react",
        "@hugeicons/core-free-icons"
      ],
      "files": [
        {
          "path": "registry/platformscode/ui/digital-stamp.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "navigation-header",
      "type": "registry:ui",
      "title": "Navigation Header",
      "description": "DGA «شريط التنقل العلوي»: logo, nav links with Base UI Menu dropdowns (icon/helper/badge submenu items), primary action, skip link, and a mobile drawer.",
      "dependencies": [
        "@base-ui/react",
        "@hugeicons/react",
        "@hugeicons/core-free-icons"
      ],
      "files": [
        {
          "path": "registry/platformscode/ui/navigation-header.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/platformscode/ui/drawer.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "doc-dialog",
      "type": "registry:ui",
      "title": "Doc Dialog",
      "description": "Document viewer link: Base UI Dialog on wide screens, swipeable bottom Drawer on phones, skeleton-backed page images.",
      "dependencies": [
        "@base-ui/react",
        "@hugeicons/react",
        "@hugeicons/core-free-icons"
      ],
      "files": [
        {
          "path": "registry/platformscode/ui/doc-dialog.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/platformscode/ui/drawer.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/platformscode/ui/skeleton.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/platformscode/hooks/use-media-query.ts",
          "type": "registry:hook"
        }
      ]
    }
  ]
