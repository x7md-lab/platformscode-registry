{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "platformscode",
  "homepage": "https://platformscode-registry.example.com",
  "items": [
    {
      "name": "platformscode-theme",
      "type": "registry:theme",
      "title": "Platformscode Theme",
      "description": "DGA «كود المنصات» design tokens: SA Flag green, gold, IBM Plex Sans Arabic, DGA radii. Light-first.",
      "cssVars": {
        "theme": {
          "font-sans": "\"IBM Plex Sans Arabic\", \"Segoe UI\", Tahoma, system-ui, sans-serif",
          "radius-sm": "4px",
          "radius-md": "8px",
          "radius-lg": "16px",
          "radius-xl": "24px",
          "color-primary-hover": "var(--primary-hover)",
          "color-primary-light": "var(--primary-light)",
          "color-destructive-light": "var(--destructive-light)",
          "color-success": "var(--success)",
          "color-success-light": "var(--success-light)"
        },
        "light": {
          "background": "#f9fafb",
          "foreground": "#1f2a37",
          "card": "#ffffff",
          "card-foreground": "#1f2a37",
          "popover": "#ffffff",
          "popover-foreground": "#1f2a37",
          "muted": "#f3f4f6",
          "muted-foreground": "#4d5761",
          "border": "#e5e7eb",
          "primary": "#1b8354",
          "primary-hover": "#166a45",
          "primary-light": "#f3fcf6",
          "primary-foreground": "#ffffff",
          "secondary": "#dba102",
          "destructive": "#d92c20",
          "destructive-light": "#fef3f2",
          "success": "#067647",
          "success-light": "#ecfdf3",
          "ring": "#161616"
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "DGA «كود المنصات» button: 4px radius, no border, 2px black focus outline. Variants: primary, outline, subtle, danger.",
      "files": [
        {
          "path": "registry/platformscode/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "DGA chip: pill with light background and strong text. Variants: default, outline, success, destructive.",
      "files": [
        {
          "path": "registry/platformscode/ui/badge.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card",
      "description": "DGA card: white surface, 16px radius, subtle border and shadow.",
      "files": [
        {
          "path": "registry/platformscode/ui/card.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "skeleton",
      "type": "registry:ui",
      "title": "Skeleton",
      "description": "Pulsing placeholder block.",
      "files": [
        {
          "path": "registry/platformscode/ui/skeleton.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "accordion",
      "type": "registry:ui",
      "title": "Accordion",
      "description": "Accordion over Base UI primitives with a framer-motion height entrance, DGA 16px header padding.",
      "dependencies": [
        "@base-ui/react",
        "framer-motion",
        "@hugeicons/react",
        "@hugeicons/core-free-icons"
      ],
      "files": [
        {
          "path": "registry/platformscode/ui/accordion.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "drawer",
      "type": "registry:ui",
      "title": "Drawer",
      "description": "Swipeable drawer over Base UI with snap points, stacking and swipe handle — animated purely with Base UI CSS variables.",
      "dependencies": ["@base-ui/react"],
      "files": [
        {
          "path": "registry/platformscode/ui/drawer.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "reveal",
      "type": "registry:component",
      "title": "Reveal",
      "description": "Scroll-reveal wrapper (framer-motion whileInView), replays on re-entry, respects prefers-reduced-motion.",
      "dependencies": ["framer-motion"],
      "files": [
        {
          "path": "registry/platformscode/components/reveal.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "use-media-query",
      "type": "registry:hook",
      "title": "useMediaQuery",
      "description": "Media-query subscription via useSyncExternalStore, with PHONE_QUERY preset.",
      "files": [
        {
          "path": "registry/platformscode/hooks/use-media-query.ts",
          "type": "registry:hook"
        }
      ]
    },
    {
      "name": "digital-stamp",
      "type": "registry:ui",
